#!/usr/bin/env bash
# tmux-here — create or attach to a tmux session named after the current directory.
#
# Portable: bash 3.2+, Linux, macOS, WSL.
# Safe: a tmux crash or sudden exit never kills the hosting shell.
# Honest: real errors are reported, not swallowed.
# ---------------------------------------------------------------------------

set -u   # strict variables; NOT -e (we handle exits ourselves)

# -- source guard -----------------------------------------------------------
# If someone does `source tmux-here`, every `exit` would kill their shell.
# Detect this and refuse early.  Works in bash; zsh sets $0 differently but
# also won't match BASH_SOURCE, so the guard is safe in both.

if [[ -n "${BASH_SOURCE:-}" && "${BASH_SOURCE[0]}" != "$0" ]]; then
    printf 'tmux-here: error: this script must be executed, not sourced\n' >&2
    return 1 2>/dev/null || exit 1
fi

# -- helpers ----------------------------------------------------------------

die()  { printf 'tmux-here: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'tmux-here: %s\n' "$*" >&2; }
info() { printf 'tmux-here: %s\n' "$*"; }

# Restore terminal sanity after a tmux crash.  Safe as no-ops when the
# terminal is already in a normal state.
restore_terminal() {
    stty sane 2>/dev/null         # re-enable echo, line editing, etc.
    printf '\033[?1049l' 2>/dev/null  # exit alternate screen buffer (raw ESC)
    printf '\033[?25h'   2>/dev/null  # show cursor in case it was hidden
}

# -- argument handling ------------------------------------------------------

force_nest=false
for arg in "$@"; do
    case "$arg" in
        -f|--force) force_nest=true ;;
        -h|--help)
            printf 'Usage: tmux-here [-f|--force]\n'
            printf '  Creates or attaches to a tmux session named after $PWD.\n'
            printf '  -f, --force   Allow nesting inside an existing tmux session.\n'
            exit 0
            ;;
        *)  die "unknown argument: $arg (try 'tmux-here --help')" ;;
    esac
done

# -- preflight --------------------------------------------------------------

command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed or not in PATH"

# Detect nested tmux.  tmux itself warns about this on stderr, but a user
# inside tmux who runs tmux-here probably didn't mean to nest.
if [[ -n "${TMUX:-}" ]] && ! $force_nest; then
    die "already inside tmux (${TMUX%%,*}). Use 'tmux-here -f' to force."
fi

# -- derive session name from cwd ------------------------------------------
# Rules:
#   1. Strip leading /
#   2. Replace every non-safe character with "_"  (safe for tmux)
#   3. Truncate to 128 chars (tmux limit is 256; shorter avoids clutter)
#   4. cwd = "/" produces empty string -> fall back to "root"

raw_path="$(pwd)" || die "cannot determine working directory"

session_name="${raw_path#/}"

# Bash 3.2+ supports [^...] in parameter expansion globs, but verify at
# runtime rather than trusting the manual.  Fall back to tr if it fails.
_glob_test="a/b"
if [[ "${_glob_test//[^ab]/_}" == "a_b" ]]; then
    session_name="${session_name//[^a-zA-Z0-9_-]/_}"
else
    # Fallback: tr handles single-char replacement reliably everywhere.
    session_name="$(printf '%s' "$session_name" | tr -c 'a-zA-Z0-9_-' '_')"
fi

session_name="${session_name:0:128}"
[[ -n "$session_name" ]] || session_name="root"

info "session: $session_name"

# -- launch tmux with crash isolation ---------------------------------------
#
# Why trap HUP/PIPE:
#   If the tmux server is killed (kill -9, OOM, segfault) while the client
#   is attached, the client receives SIGHUP / SIGPIPE.  Without traps those
#   signals propagate to the hosting shell — especially dangerous when this
#   script is invoked from a shell function or alias chain.
#
# Why NOT trap TERM/INT:
#   The user must be able to Ctrl-C out if tmux hangs.
#
# Why we do NOT redirect stderr:
#   tmux prints its own diagnostics (bad config, socket errors, TERM issues).
#   Swallowing them leaves the user blind.  Let tmux speak for itself.

trap '' HUP PIPE

tmux new-session -As "$session_name"
rc=$?

trap - HUP PIPE    # restore defaults immediately

# -- post-exit terminal recovery -------------------------------------------
#
# If tmux crashed or was killed, the terminal may be in raw mode, stuck in
# the alternate screen buffer, or have the cursor hidden.  Restore sanity
# before doing anything else.  These are safe no-ops on a healthy terminal.

if (( rc != 0 )); then
    restore_terminal
fi

# -- report outcome ---------------------------------------------------------
#
# tmux exit codes:
#   0   — clean exit: session ended OR user detached (Ctrl-b d)
#   1   — generic error (server unreachable, bad args, socket failure, ...)
#  >128 — killed by signal (128 + signal number)
#
# We exit with tmux's actual code so callers/scripts can react, but we
# never let a *signal* propagate (that's what the traps above handle).

if (( rc == 0 )); then
    exit 0
fi

warn "tmux exited with code $rc"

if (( rc > 128 )); then
    sig=$(( rc - 128 ))
    warn "tmux was killed by signal $sig ($(kill -l "$sig" 2>/dev/null || echo "unknown"))"
fi

# Actionable hint for socket directory issues — but only on WSL where this
# is a known problem.  On native Linux/macOS, tmux's own stderr is enough.
if (( rc == 1 )) && [[ -f /proc/version ]] \
        && grep -qi microsoft /proc/version 2>/dev/null; then
    warn "WSL hint: if this is a socket error, try:"
    warn "  export TMUX_TMPDIR=\"\$HOME/.tmux-sockets\" && mkdir -p \"\$TMUX_TMPDIR\""
fi

exit "$rc"
