#!/usr/bin/env bash
# zell-continue — interactive menu to list and attach to zellij sessions
#
# Usage: zell-continue [-f|--force] [-h|--help]
#
# Lists all existing zellij sessions in a numbered menu and prompts the user
# to pick one to attach to.  Useful when you have several long-running
# sessions and want a quick picker instead of remembering exact names.
#
# Options:
#   -f, --force   Allow attaching from inside an existing zellij session
#                 (nested attach).  Without this flag the script will
#                 refuse to run when $ZELLIJ is already set.
#   -h, --help    Show this help text and exit.
#
# Compatible with: bash 3.2+, macOS, Linux, WSL

# NOT -e (we handle exits ourselves); -u catches typos in variable names.
set -u

# ---------------------------------------------------------------------------
# Colours (respected: NO_COLOR, non-interactive pipes)
# ---------------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    CYAN=$'\033[0;36m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[0;33m'
    RED=$'\033[0;31m'
    RESET=$'\033[0m'
else
    BOLD='' DIM='' CYAN='' GREEN='' YELLOW='' RED='' RESET=''
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die() {
    printf '%szell-continue: error:%s %s\n' "$RED" "$RESET" "$1" >&2
    if [ -n "${2:-}" ]; then
        printf '       %sFix:%s %s\n' "$YELLOW" "$RESET" "$2" >&2
    fi
    exit 1
}

warn() { printf '%szell-continue:%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
info() { printf '%szell-continue:%s %s\n' "$CYAN" "$RESET" "$*"; }

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

force_nest=false

for arg in "$@"; do
    case "$arg" in
        -f|--force) force_nest=true ;;
        -h|--help)
            printf '%sUsage:%s zell-continue [-f|--force] [-h|--help]\n\n' \
                   "$BOLD" "$RESET"
            printf '  List zellij sessions and attach to the one you pick.\n\n'
            printf '  %s-f, --force%s   Allow nested attach (inside zellij)\n' \
                   "$BOLD" "$RESET"
            printf '  %s-h, --help%s    Show this help\n' "$BOLD" "$RESET"
            exit 0
            ;;
        *)  die "unknown argument: $arg" "Try 'zell-continue --help'" ;;
    esac
done

# ---------------------------------------------------------------------------
# Preflight checks
# ---------------------------------------------------------------------------

# 1. zellij must be installed
command -v zellij >/dev/null 2>&1 \
    || die "zellij is not installed" \
           "Install it with: cargo install zellij  (or check https://zellij.dev)"

# 2. Guard against nesting (unless --force)
#    Zellij sets $ZELLIJ (to "0") inside every pane.
if [ -n "${ZELLIJ:-}" ] && [ "$force_nest" = false ]; then
    die "already inside a zellij session (${ZELLIJ_SESSION_NAME:-unknown})" \
        "Detach first (Ctrl-o d), or re-run with --force to nest"
fi

# 3. Fetch session names.
#    --no-formatting strips ANSI colour codes.
#    --short prints one session name per line, nothing else.
#    zellij ls exits 0 even with no sessions but prints nothing to stdout
#    when --short is used.
name_list="$(zellij list-sessions --no-formatting --short 2>/dev/null)" || true

if [ -z "$name_list" ]; then
    die "no zellij sessions found" \
        "Start one with: zellij -s <name>  (or use zell-here)"
fi

# 4. Fetch full session details for the display column.
#    Format per line: "session-name [Created 2h 5m ago] (ATTACHED)"
detail_list="$(zellij list-sessions --no-formatting 2>/dev/null)" || true

# ---------------------------------------------------------------------------
# Build & display menu
# ---------------------------------------------------------------------------

# Read session names into an array (bash 3.2+ compatible).
names=()
while IFS= read -r line; do
    names+=("$line")
done <<< "$name_list"

# Read full detail lines into a parallel array.
details=()
while IFS= read -r line; do
    details+=("$line")
done <<< "$detail_list"

count=${#names[@]}

printf '\n%s%s zellij session%s found:%s\n\n' \
       "$BOLD" "$count" "$([ "$count" -ne 1 ] && echo 's' || true)" "$RESET"

# Find the longest session name so we can align the detail column.
max_name=0
for name in "${names[@]}"; do
    len=${#name}
    [ "$len" -gt "$max_name" ] && max_name=$len
done

idx=1
for name in "${names[@]}"; do
    # Detail is everything after the session name in the full line.
    # Fall back to empty string if the detail array is shorter (defensive).
    full="${details[$((idx - 1))]:-}"
    detail="${full#"$name"}"
    # Strip leading whitespace from the detail remainder.
    detail="${detail# }"

    printf ' %s%d)%s %s%-*s%s %s%s%s\n' \
           "$GREEN" "$idx" "$RESET" \
           "$BOLD" "$max_name" "$name" "$RESET" \
           "$DIM" "$detail" "$RESET"
    idx=$((idx + 1))
done

printf '\n'

# ---------------------------------------------------------------------------
# Prompt for selection
# ---------------------------------------------------------------------------

# Must be an interactive terminal to prompt.
if ! [ -t 0 ]; then
    die "stdin is not a terminal — cannot prompt for selection" \
        "Run zell-continue interactively, or use: zellij attach <name>"
fi

while true; do
    printf '%sSelect session [1-%d] (q to quit):%s ' "$CYAN" "$count" "$RESET"
    read -r choice || { printf '\n'; info "cancelled"; exit 0; }

    # Quit
    case "${choice:-}" in
        q|Q|quit|exit) info "cancelled"; exit 0 ;;
    esac

    # Validate: must be a number in range.
    if ! printf '%s' "$choice" | grep -qE '^[0-9]+$'; then
        warn "please enter a number between 1 and $count"
        continue
    fi

    # Force base-10 so leading zeros aren't misread as octal in $(( )).
    choice=$((10#$choice))

    if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
        warn "out of range — pick between 1 and $count"
        continue
    fi

    break
done

# ---------------------------------------------------------------------------
# Attach
# ---------------------------------------------------------------------------

target="${names[$((choice - 1))]}"

info "attaching to ${BOLD}${target}${RESET}"
exec zellij attach "$target"
